{
  "name": "@subatone/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clerk/backend": "^1.13.0",
    "@prisma/client": "^5.16.0",
    "@subatone/db": "*",
    "@subatone/types": "*",
    "@subatone/validators": "*",
    "bullmq": "^5.12.0",
    "expo-server-sdk": "^3.10.0",
    "hono": "^4.5.0",
    "ioredis": "^5.4.0",
    "pino": "^9.3.0",
    "pino-pretty": "^11.2.0",
    "zod": "^3.23.0",
    "@hono/zod-validator": "^0.3.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^22.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "setupFiles": ["./jest.setup.ts"],
    "moduleNameMapper": {
      "^@subatone/types$": "<rootDir>/../../packages/types/src/index.ts",
      "^@subatone/validators$": "<rootDir>/../../packages/validators/src/index.ts",
      "^@subatone/db$": "<rootDir>/../../packages/db/src/__mocks__/index.ts",
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "transform": {
      "^.+\\.ts$": ["ts-jest", { "isolatedModules": true, "diagnostics": false }]
    },
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/index.ts",
      "!src/**/*.d.ts"
    ]
  }
}
