# ──────────────────────────────────────────────
# Subatone — Environment Variables
# Copy to .env and fill in real values.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────

# ── Clerk Auth ──────────────────────────────
# https://dashboard.clerk.com → API Keys
CLERK_SECRET_KEY=sk_test_REPLACE_ME
CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME

# ── Database (Supabase) ──────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DB?schema=public
DATABASE_URL=postgresql://postgres:REPLACE_ME@db.REPLACE_ME.supabase.co:5432/postgres?schema=public

# ── Redis (Upstash) ─────────────────────────
REDIS_URL=rediss://REPLACE_ME:REPLACE_ME@REPLACE_ME.upstash.io:6379

# ── Expo Push Notifications ──────────────────
# No secret needed — uses FCM internally via Expo's servers

# ── App Config ───────────────────────────────
NODE_ENV=development
API_PORT=3000
API_BASE_URL=http://localhost:3000

# ── Mobile ───────────────────────────────────
# Must match package.json "name" under expo config
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME

# ── Rate Limiting ────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_AUTH_MAX=10

# ── Logging ──────────────────────────────────
LOG_LEVEL=info
