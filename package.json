{
  "name": "subatone",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "mobile": "npm run start --workspace=@subatone/mobile",
    "api": "npm run dev --workspace=@subatone/api",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:generate": "npm run db:generate --workspace=@subatone/db",
    "db:migrate": "npm run db:migrate --workspace=@subatone/db",
    "db:seed": "npm run db:seed --workspace=@subatone/db",
    "db:seed:dev": "npm run db:seed:dev --workspace=@subatone/db",
    "db:seed:library": "npm run db:seed:library --workspace=@subatone/db",
    "db:studio": "npm run db:studio --workspace=@subatone/db"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "expo-auth-session": "~7.0.11",
    "expo-crypto": "~15.0.9",
    "expo-local-authentication": "~17.0.8",
    "expo-web-browser": "~15.0.11",
    "react-dom": "19.1.0",
    "react-native-worklets": "^0.5.1"
  },
  "overrides": {
    "react": "19.1.0"
  }
}
